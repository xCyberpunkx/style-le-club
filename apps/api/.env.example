# Local dev — matches infra/docker/docker-compose.dev.yml
DATABASE_URL="postgresql://slc:slc_dev_only@localhost:5432/style_le_club"
REDIS_URL="redis://localhost:6379"

# Phase 3 (Auth). Generate real values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Run it twice — access and refresh secrets must be DIFFERENT values, never
# the same secret reused for both token types.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN_MINUTES="15"
JWT_REFRESH_EXPIRES_IN_DAYS="30"
