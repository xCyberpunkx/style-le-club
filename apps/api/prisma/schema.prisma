// ============================================================
// Style Le Club — Phase 1 Schema
// Foundation: Organization (tenant), Auth, Employees, Roles, Permissions
// Built for Style Le Club today, structured so multi-tenant SaaS is an
// additive change later — every business entity carries an organizationId
// from day one. Permission is the one deliberately GLOBAL table (a fixed
// system catalog of capability strings); Role is tenant-scoped so each
// organization can compose its own roles from that shared catalog.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7 requirement) and,
  // at runtime, in the @prisma/adapter-pg instance — never here.
}

// ------------------------------------------------------------
// ORGANIZATION — the tenant. Style Le Club is the first (and for now,
// only) row here. Every tenant-owned table below carries organizationId.
// ------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // reserved for future subdomain-based tenant routing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  employees     Employee[]
  roles         Role[]
  auditLogs     AuditLog[]
  members       Member[]
  counters      Counter[]
  plans         Plan[]
  subscriptions Subscription[]

  @@map("organizations")
}

// ------------------------------------------------------------
// USER — an authenticatable login account. Deliberately separate from
// Employee: not every staff member needs system access (e.g. a cleaner),
// but every login-having person needs an Employee-equivalent profile.
// Revisit if this separation proves more friction than value in practice.
// ------------------------------------------------------------

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  employee      Employee?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

// ------------------------------------------------------------
// EMPLOYEE — staff profile. Optionally linked to a User (login access).
// ------------------------------------------------------------

model Employee {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  fullName  String
  phone     String?
  jobTitle  String?
  hireDate  DateTime?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  active    Boolean   @default(true)
  deletedAt DateTime? // soft delete — staff history must survive departure

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([roleId])
  @@map("employees")
}

// ------------------------------------------------------------
// MEMBER — the client (Phase 6). First real business entity; everything
// downstream (Subscriptions, CheckIns, Appointments, Payments) references
// this. Scoped to what Phase 6 alone needed at the time — some of the
// notes below are now historical (Plan/Subscription exist as of Phase 7)
// but kept for the record of why they weren't added directly to Member:
//
//   - No planId / currentSubscription on Member itself: a Member's
//     "current plan" is derived by joining the active SubscriptionMember
//     row, not denormalized here — one source of truth for plan state.
//     See Subscription below for the actual relationship.
//   - No status (Active/Expired/Frozen) on Member itself: that status
//     belongs to Subscription (a member's *membership* can be
//     active/expired/frozen; the member record itself is simply
//     active/archived via the soft-delete pair below). Computing a
//     member's display status means checking their current Subscription.
//   - No assignedCoach: gap analysis open question #1 (Coach vs Employee
//     vs a CoachProfile extension) is still unresolved. Deferred to
//     whichever phase resolves it (Coaches / Phase 10 Appointments).
//   - age: stores dateOfBirth instead — age computed from a fixed value
//     silently goes stale; date of birth doesn't.
// ------------------------------------------------------------

model Member {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Human-readable client-facing ID (e.g. "M-000001"), generated once at
  // creation via CounterService — never user-entered, so it can't collide
  // or be left blank. See common/counters/counters.service.ts.
  memberCode String

  fullName    String
  phone       String
  email       String?
  dateOfBirth DateTime?
  weightKg    Decimal? @db.Decimal(5, 2)
  heightCm    Decimal? @db.Decimal(5, 2)
  goal        String?

  joinDate DateTime @default(now())

  active    Boolean   @default(true)
  deletedAt DateTime? // soft delete — a member's history (past visits,
  // payments, appointments) must survive them leaving the club.

  subscriptionMemberships SubscriptionMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, memberCode])
  @@index([organizationId])
  @@index([organizationId, phone])
  @@map("members")
}

// ------------------------------------------------------------
// PLAN — the catalog (Phase 7). What a club sells: a name, a duration, a
// price, whether it can cover more than one linked member (a "couple"
// style plan). Soft-deleted like Member — a plan that's retired must
// still be resolvable for every past Subscription that referenced it.
// ------------------------------------------------------------

model Plan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?
  durationDays Int // e.g. 30, 90, 365 — kept as days, not a month/year enum,
  // so a club can sell a 45-day promo plan without a schema change.
  price Decimal @db.Decimal(10, 2)

  // Resolves the gap analysis's open "couple plan" question: one Plan can
  // allow a Subscription bought against it to cover more than one Member
  // (see SubscriptionMember below), rather than requiring two separate
  // Subscription rows kept in sync by hand.
  allowsLinkedMembers Boolean @default(false)
  maxLinkedMembers    Int     @default(1)

  isPopular Boolean @default(false) // mockup's "Popular" badge

  active    Boolean   @default(true)
  deletedAt DateTime?

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  FROZEN
  CANCELLED
}

// ------------------------------------------------------------
// SUBSCRIPTION — a specific enrollment in a Plan (Phase 7). One
// Subscription can cover more than one Member via SubscriptionMember
// (the couple-plan case) — status, dates, and freeze state are shared
// by every linked member rather than duplicated per person.
//
// priceAtPurchase is a frozen snapshot (blueprint section 4: "price/rate
// snapshots are frozen at transaction time so a later price change never
// retroactively rewrites history") — Plan.price can change without
// altering what a past Subscription actually cost.
//
// ASSUMPTION FLAGGED FOR CONFIRMATION: a member may hold at most one
// ACTIVE or FROZEN subscription at a time — enforced in the service
// layer (subscriptions.service.ts), not the DB, since the check spans
// the SubscriptionMember join. The blueprint asks to confirm this
// against the original desktop build's overlap logic, which wasn't
// available to reference here; if the legacy behavior differs (e.g. a
// renewal queued to start when the current one ends), this needs
// revisiting.
// ------------------------------------------------------------

model Subscription {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(ACTIVE)

  startDate DateTime @default(now())
  endDate   DateTime

  priceAtPurchase Decimal @db.Decimal(10, 2)

  // Freeze tracking kept deliberately minimal for Phase 7: the mockup's
  // Freeze action needs a timestamp and the ability to Unfreeze, not a
  // full freeze-day-banking ledger (extending endDate by days frozen).
  // If the club needs "freeze time gets added back to your expiry," that
  // banking logic is a Phase 7 follow-up, not a schema change — it reads
  // frozenAt against the unfreeze time and shifts endDate accordingly.
  frozenAt DateTime?

  cancelledAt DateTime?

  members SubscriptionMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([planId])
  @@map("subscriptions")
}

// Join table resolving Subscription <-> Member as many-to-many, so a
// couple plan's two people share one Subscription (one price, one
// expiry, one freeze) instead of needing two rows kept in sync.
// isPrimary marks who's billed/contacted as the account holder.
model SubscriptionMember {
  id String @id @default(uuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  isPrimary Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([subscriptionId, memberId])
  @@index([memberId])
  @@map("subscription_members")
}

// ------------------------------------------------------------
// ROLE — tenant-scoped. Each organization composes its own roles from the
// shared Permission catalog below (e.g. "give this receptionist POS access
// but not refunds" becomes a data change, not a redeploy).
// ------------------------------------------------------------

model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name            String
  isSystemDefault Boolean @default(false) // e.g. an auto-created "Admin" role per org

  employees   Employee[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

// ------------------------------------------------------------
// PERMISSION — deliberately GLOBAL, not tenant-scoped. A fixed system
// catalog of capability strings (e.g. "members.create", "pos.refund").
// Seeded once via migration/seed script, not created ad-hoc per tenant.
// ------------------------------------------------------------

model Permission {
  key         String @id // e.g. "members.create", "pos.refund"
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey  String
  permission     Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

// ------------------------------------------------------------
// REFRESH TOKEN — hashed at rest, one row per issued device session, so
// "log out this device" / "revoke all sessions" are real, immediate
// operations rather than "wait for expiry."
// ------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  deviceInfo String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------
// AUDIT LOG — who changed what. Every sensitive action (payments, role
// changes, permission changes — expanded as later modules are built)
// writes here. actorUserId is nullable to allow system-initiated actions
// (e.g. an automated expiration sweep) to still log meaningfully.
// ------------------------------------------------------------

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id])

  action     String // "CREATE" | "UPDATE" | "DELETE"
  entityName String
  entityId   String
  oldValue   Json?
  newValue   Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([entityName, entityId])
  @@map("audit_logs")
}

// ------------------------------------------------------------
// COUNTER — generic per-organization atomic sequence generator. First
// consumer is Member.memberCode; built reusable (name-keyed, not
// hardcoded to "member") because the same need resurfaces verbatim for
// invoice/receipt numbering in the Payments phase (blueprint section 4:
// "atomic receipt numbering"). One mechanism, not one hand-rolled counter
// per entity that needs a sequential human-readable ID.
// ------------------------------------------------------------

model Counter {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name  String // e.g. "member_code", later "invoice_number"
  value Int    @default(0)

  @@unique([organizationId, name])
  @@map("counters")
}
